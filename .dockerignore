# Everything the build does not need, so an unrelated change does not invalidate the context.
.git
.github
.idea
.vscode
test

# Local state that must never reach an image
*.db
*.db-wal
*.db-shm
master.key
*.keytab
*.token
*.pem
*.crt
*.key
ldap-kdc.yaml

# The console's sources and node_modules: the binary embeds the committed bundle under
# internal/api/ui/dist, so the image build needs none of it
ui

# Build output and documentation
/ldap-kdc
/dist
*.md
Makefile
