# Everything the build does not need, so an unrelated change does not invalidate the context.
.git
.github
.idea
.vscode
test

# Local state that must never reach an image
*.db
*.db-wal
*.db-shm
master.key
*.keytab
*.token
*.pem
*.crt
*.key
ldap-kdc.yaml

# The console is built inside the image by make build, on the image's platform. Dependencies
# installed on the host carry the host's native binaries (esbuild's among them), and a bundle built
# on the host is exactly what make build is there to replace.
ui/node_modules
internal/api/ui/dist

# Build output and documentation
/ldap-kdc
/dist
*.md
